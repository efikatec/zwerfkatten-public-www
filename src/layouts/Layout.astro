---
interface Props {
    title: string;
}
import '@fontsource/montserrat';
const {title} = Astro.props;
---

<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>{title}</title>
    <link rel="icon" href="/favicon.ico">
</head>
<body class="bg-white min-h-screen">
<nav>
    <div class="bg-cat-secondary relative flex items-center justify-center px-4 py-3 h-[100px] md:h-[200px]">
        <!-- Centered logo + subtitle -->
        <div class="flex flex-col items-center gap-1 md:gap-2">
            <a href="/" class="block">
                <div id="logo" class="text-cat-primary h-12 md:h-36" aria-hidden="true"></div>
            </a>
            <span class="text-cat-primary text-xs md:text-base font-medium tracking-wide">VZW Operatie Zwerfkat - zwerfkattenbeleid voor Oudenaarde</span>
        </div>

        <!-- Mobile menu button -->
        <button id="mobile-menu-button" class="absolute right-4 md:hidden text-cat-primary focus:outline-none"
                aria-label="Toggle menu">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M4 6h16M4 12h16M4 18h16"></path>
                <path id="close-icon" class="hidden" stroke-linecap="round" stroke-linejoin="round"
                      stroke-width="2"
                      d="M6 18L18 6M6 6l12 12"></path>
            </svg>
        </button>
    </div>
    <!-- Desktop menu -->
    <div class="hidden md:flex items-center space-x-4 lg:space-x-6 px-5 py-5">
        <a href="/" class="text-cat-primary hover:text-cat-secondary transition">Home</a>
        <a href="/onze-missie" class="text-cat-primary hover:text-cat-secondary transition">Onze missie</a>
        <a href="/zwerfkatten" class="text-cat-primary hover:text-cat-secondary transition">Zwerfkatten</a>
        <a href="/adopteren" class="text-cat-primary hover:text-cat-secondary transition">Adopteren</a>
        <a href="/verplichtingen" class="text-cat-primary hover:text-cat-secondary transition">Wettelijke verplichtingen</a>
        <a href="/doneren" class="text-cat-primary hover:text-cat-secondary transition">Doneren</a>
        <a href="/weetjes" class="text-cat-primary hover:text-cat-secondary transition">Weetjes</a>
        <a href="/blog" class="text-cat-primary hover:text-cat-secondary transition">Purrrfect nieuws</a>

    </div>
    <!-- Mobile menu -->
    <div id="mobile-menu" class="hidden md:hidden mt-4 pb-4">
        <div class="flex flex-col space-y-3">
            <a href="/"
               class="text-cat-primary hover:text-cat-secondary transition py-2 px-4 rounded hover:bg-cat-secondary hover:bg-opacity-10">Home</a>
            <a href="/adopteren"
               class="text-cat-primary hover:text-cat-secondary transition py-2 px-4 rounded hover:bg-cat-secondary hover:bg-opacity-10">Adopteren</a>
            <a href="/weetjes"
               class="text-cat-primary hover:text-cat-secondary transition py-2 px-4 rounded hover:bg-cat-secondary hover:bg-opacity-10">Weetjes</a>
            <a href="/blog"
               class="text-cat-primary hover:text-cat-secondary transition py-2 px-4 rounded hover:bg-cat-secondary hover:bg-opacity-10">Purrrfect nieuws</a>
            <a href="/contact"
               class="bg-white text-cat-primary px-4 py-2 rounded-lg font-semibold hover:bg-cat-secondary hover:text-white transition">
                Contacteer ons
            </a>
        </div>
    </div>
</nav>

<main>
    <slot/>
</main>

<footer class="bg-cat-secondary text-white py-8 relative">
    <div class="max-w-6xl mx-auto px-4 py-8">
        <div class="flex flex-col md:flex-row items-center justify-between gap-4">
            <div class="flex gap-2">
            <span>Volg ons</span><a href="https://www.facebook.com/groups/54131394964?locale=nl_BE" target="_blank" rel="noopener"
               aria-label="Facebook"
               class="text-white hover:text-cat-primary transition">
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M22 12a10 10 0 10-11.5 9.9v-7h-2.2V12h2.2V9.7c0-2.2 1.3-3.4 3.3-3.4.95 0 1.95.17 1.95.17v2.1h-1.07c-1.06 0-1.39.66-1.39 1.33V12h2.36l-.38 2.9h-1.98v7A10 10 0 0022 12z"/>
                </svg>
            </a>
            </div>
            <a href="/contact"
               class="bg-cat-primary text-white px-3 py-2 lg:px-4 rounded-lg font-semibold hover:bg-cat-secondary hover:text-white transition text-sm lg:text-base">
                Contacteer ons
            </a>
        </div>

        </div>

            <!-- Full-width footer acknowledgement / copyright that spans the entire footer -->
            <div class="w-full pr-1 pl-1 text-center ">
                <p class="text-sm sm:text-base">&copy; 2025 Zwerfkat. Alle rechten voorbehouden.</p>
                <p class="text-sm sm:text-base">Erkend als dierenasiel door de Vlaamse overheid met HK 30404538</p>
            </div>
        </footer>

<script>
    // Mobile menu toggle
    const mobileMenuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    const menuIcon = document.getElementById('menu-icon');
    const closeIcon = document.getElementById('close-icon');

    mobileMenuButton?.addEventListener('click', () => {
        mobileMenu?.classList.toggle('hidden');
        menuIcon?.classList.toggle('hidden');
        closeIcon?.classList.toggle('hidden');
    });


    // Fetch and inline the external SVG so `currentColor` inside the SVG inherits the container's color.
    fetch('/logo.svg')
        .then(res => res.text())
        .then(text => {
            // keep only the <svg ...>...</svg> part (remove XML prolog / DOCTYPE if present)
            const svgStart = text.indexOf('<svg');
            if (svgStart === -1) return;
            const svgText = text.slice(svgStart);

            // Create a temporary container to parse the SVG
            const temp = document.createElement('div');
            temp.innerHTML = svgText;
            const svg = temp.querySelector('svg');
            if (!svg) return;

            // Remove fixed size attributes so CSS can control sizing
            svg.removeAttribute('width');
            svg.removeAttribute('height');

            // Ensure aspect ratio is preserved and make the svg fill the parent
            svg.setAttribute('preserveAspectRatio', 'xMidYMid meet');
            svg.style.width = 'auto';
            svg.style.height = '100%';
            svg.style.display = 'block';

            // Inline the processed SVG into the #logo container
            const container = document.getElementById('logo');
            container.innerHTML = '';
            container.appendChild(svg);
        })
        .catch(() => { /* handle error if needed */
        });

</script>
<!-- Global smooth-scroll helper (handles data-target and in-page anchors) -->
<script src="/js/scroll-to.js" defer></script>
</body>
</html>
