---
interface Props {
    title: string;
}
import '@fontsource/montserrat';
const {title} = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const active = (href: string) =>
    (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'))
        ? 'bg-white/30 font-semibold'
        : 'hover:bg-white/20';
---

<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>{title}</title>
    <link rel="icon" href="/favicon.ico">
</head>
<body class="bg-white min-h-screen flex flex-col">

<header class="sticky top-0 z-50 shadow-sm">
    <!-- Top bar: logo + mobile toggle -->
    <div class="bg-cat-secondary md:bg-white md:border-b md:border-gray-100">
        <div class="max-w-6xl mx-auto px-4">
            <div class="flex items-center justify-between h-16">
                <a href="/" class="flex items-center gap-3 shrink-0">
                    <div id="logo" class="text-white md:text-cat-primary h-10" aria-hidden="true"></div>
                    <div class="block leading-tight">
                        <p class="text-white md:text-cat-primary text-base font-bold">VZW Operatie Zwerfkat</p>
                        <p class="text-white/70 md:text-gray-400 text-xs">Zwerfkattenbeleid voor Oudenaarde</p>
                    </div>
                </a>

                <!-- Contact button (desktop) -->
                <a href="/contact"
                   class="hidden md:inline-flex px-4 py-1.5 text-sm bg-cat-primary text-white rounded-md hover:brightness-95 transition font-medium">
                    Contact
                </a>

                <!-- Mobile menu button -->
                <button id="mobile-menu-button" class="md:hidden p-2 text-white hover:text-white/70 focus:outline-none"
                        aria-label="Toggle menu">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M4 6h16M4 12h16M4 18h16"></path>
                        <path id="close-icon" class="hidden" stroke-linecap="round" stroke-linejoin="round"
                              stroke-width="2"
                              d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </button>
            </div>
        </div>
    </div>

    <!-- Desktop nav bar -->
    <nav class="hidden md:block bg-cat-secondary">
        <div class="max-w-6xl mx-auto px-4">
            <div class="flex items-center gap-0.5 h-10">
                <a href="/" class={`px-3 py-1.5 text-sm text-white rounded transition ${active('/')}`}>Home</a>
                <a href="/onze-missie" class={`px-3 py-1.5 text-sm text-white rounded transition ${active('/onze-missie')}`}>Missie</a>
                <a href="/zwerfkatten" class={`px-3 py-1.5 text-sm text-white rounded transition ${active('/zwerfkatten')}`}>Zwerfkatten</a>
                <a href="/adopteren" class={`px-3 py-1.5 text-sm text-white rounded transition ${active('/adopteren')}`}>Adopteren</a>
                <a href="/verplichtingen" class={`px-3 py-1.5 text-sm text-white rounded transition ${active('/verplichtingen')}`}>Verplichtingen</a>
                <a href="/doneren" class={`px-3 py-1.5 text-sm text-white rounded transition ${active('/doneren')}`}>Doneren</a>
                <a href="/weetjes" class={`px-3 py-1.5 text-sm text-white rounded transition ${active('/weetjes')}`}>Weetjes</a>
                <a href="/blog" class={`px-3 py-1.5 text-sm text-white rounded transition ${active('/blog')}`}>Nieuws</a>
            </div>
        </div>
    </nav>

    <!-- Mobile menu -->
    <div id="mobile-menu" class="hidden md:hidden bg-cat-secondary">
        <div class="max-w-6xl mx-auto px-4 py-2 flex flex-col gap-0.5">
            <a href="/" class={`px-3 py-2 text-sm text-white rounded transition ${active('/')}`}>Home</a>
            <a href="/onze-missie" class={`px-3 py-2 text-sm text-white rounded transition ${active('/onze-missie')}`}>Onze missie</a>
            <a href="/zwerfkatten" class={`px-3 py-2 text-sm text-white rounded transition ${active('/zwerfkatten')}`}>Zwerfkatten</a>
            <a href="/adopteren" class={`px-3 py-2 text-sm text-white rounded transition ${active('/adopteren')}`}>Adopteren</a>
            <a href="/verplichtingen" class={`px-3 py-2 text-sm text-white rounded transition ${active('/verplichtingen')}`}>Wettelijke verplichtingen</a>
            <a href="/doneren" class={`px-3 py-2 text-sm text-white rounded transition ${active('/doneren')}`}>Doneren</a>
            <a href="/weetjes" class={`px-3 py-2 text-sm text-white rounded transition ${active('/weetjes')}`}>Weetjes</a>
            <a href="/blog" class={`px-3 py-2 text-sm text-white rounded transition ${active('/blog')}`}>Purrrfect nieuws</a>
            <a href="/contact"
               class="mt-1 mb-1 px-4 py-2 text-sm bg-cat-primary text-white rounded hover:brightness-95 transition font-medium text-center">
                Contacteer ons
            </a>
        </div>
    </div>
</header>

<main class="flex-1">
    <slot/>
</main>

<footer class="border-t border-gray-100 bg-white py-8 mt-12">
    <div class="max-w-6xl mx-auto px-4">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
            <div class="flex items-center gap-2 text-sm text-gray-500">
                <span>Volg ons</span>
                <a href="https://www.facebook.com/groups/54131394964?locale=nl_BE" target="_blank" rel="noopener"
                   aria-label="Facebook"
                   class="text-cat-primary hover:opacity-75 transition">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M22 12a10 10 0 10-11.5 9.9v-7h-2.2V12h2.2V9.7c0-2.2 1.3-3.4 3.3-3.4.95 0 1.95.17 1.95.17v2.1h-1.07c-1.06 0-1.39.66-1.39 1.33V12h2.36l-.38 2.9h-1.98v7A10 10 0 0022 12z"/>
                    </svg>
                </a>
            </div>
            <div class="text-center text-xs text-gray-400">
                <p>&copy; 2025 Zwerfkat. Alle rechten voorbehouden.</p>
                <p>Erkend als dierenasiel door de Vlaamse overheid met HK 30404538</p>
            </div>
            <a href="/contact"
               class="text-sm bg-cat-primary text-white px-4 py-2 rounded-md font-medium hover:brightness-95 transition">
                Contacteer ons
            </a>
        </div>
    </div>
</footer>

<script>
    // Mobile menu toggle
    const mobileMenuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    const menuIcon = document.getElementById('menu-icon');
    const closeIcon = document.getElementById('close-icon');

    mobileMenuButton?.addEventListener('click', () => {
        mobileMenu?.classList.toggle('hidden');
        menuIcon?.classList.toggle('hidden');
        closeIcon?.classList.toggle('hidden');
    });

    // Fetch and inline the external SVG so `currentColor` inside the SVG inherits the container's color.
    fetch('/logo.svg')
        .then(res => res.text())
        .then(text => {
            const svgStart = text.indexOf('<svg');
            if (svgStart === -1) return;
            const svgText = text.slice(svgStart);
            const temp = document.createElement('div');
            temp.innerHTML = svgText;
            const svg = temp.querySelector('svg');
            if (!svg) return;
            svg.removeAttribute('width');
            svg.removeAttribute('height');
            svg.setAttribute('preserveAspectRatio', 'xMidYMid meet');
            svg.style.width = 'auto';
            svg.style.height = '100%';
            svg.style.display = 'block';
            const container = document.getElementById('logo');
            container.innerHTML = '';
            container.appendChild(svg);
        })
        .catch(() => {});
</script>
<!-- Global smooth-scroll helper (handles data-target and in-page anchors) -->
<script src="/js/scroll-to.js" defer></script>
</body>
</html>
