---
import Layout from '../layouts/Layout.astro';

// Get all blog posts
const blogPosts = await Astro.glob('../content/blog/*.md');

// Sort by date (newest first)
const sortedPosts = blogPosts.sort((a, b) => {
  const dateA = new Date(a.frontmatter.date);
  const dateB = new Date(b.frontmatter.date);
  return dateB.getTime() - dateA.getTime();
});
---

<Layout title="Blog - Zwerfkat">
  <div class="container mx-auto px-4 py-8 sm:py-12">
    <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-center text-cat-secondary mb-6 sm:mb-8">
      Purrrfect Nieuws
    </h1>

    <div class="max-w-8xl mx-auto space-y-6 sm:space-y-8">
      {sortedPosts.map((post) => (
        <article class="bg-white border border-cat-primary rounded-lg p-6 sm:p-8 hover:shadow-xl transition">
          <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between mb-3 sm:mb-4 gap-2">
            <span class="text-xs sm:text-sm text-gray-500">
              {new Date(post.frontmatter.date).toLocaleDateString('nl-NL', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
              })}
            </span>
            <span class="text-xs sm:text-sm text-cat-primary font-semibold">
              {post.frontmatter.author}
            </span>
          </div>
          {post.frontmatter.image && (
              <div class="flex justify-center mb-4">
                <img
                    src={post.frontmatter.image}
                    alt={post.frontmatter.title}
                    class="w-full max-w-[640px] rounded object-cover"
                />
              </div>
          )}


          
          <h2 class="text-2xl sm:text-3xl font-bold text-cat-secondary mb-3 sm:mb-4">
            {post.frontmatter.title}
          </h2>
          
          <p class="text-sm sm:text-base text-gray-700 mb-4 sm:mb-6">
            {post.frontmatter.excerpt}
          </p>
          
          <div class="prose prose-sm sm:prose-lg max-w-none">
            <post.Content />
          </div>
        </article>
      ))}
    </div>

    {sortedPosts.length === 0 && (
      <div class="text-center text-gray-500 py-12">
        <p class="text-lg sm:text-xl">Nog geen blogposts beschikbaar. Kom binnenkort terug!</p>
      </div>
    )}
  </div>
</Layout>
