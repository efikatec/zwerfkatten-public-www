---
import Layout from '../layouts/Layout.astro';

// Get all blog posts
const blogPosts = Object.values(import.meta.glob('../content/blog/*.md', { eager: true })) as any[];

// Sort by date (newest first)
const sortedPosts = blogPosts.sort((a, b) => {
  const dateA = new Date(a.frontmatter.date);
  const dateB = new Date(b.frontmatter.date);
  return dateB.getTime() - dateA.getTime();
});
---

<Layout title="Blog - Zwerfkat">
  <div class="max-w-4xl mx-auto px-4 py-10 sm:py-16">
    <h1 class="text-3xl sm:text-4xl font-bold text-cat-primary mb-2">Purrrfect Nieuws</h1>
    <p class="text-gray-400 text-sm mb-8">Het laatste nieuws van Operatie Zwerfkat vzw.</p>

    <div class="space-y-6">
      {sortedPosts.map((post) => (
        <article class="bg-white border border-gray-200 rounded-lg shadow-sm p-6 sm:p-8 hover:shadow-md transition">
          <div class="flex items-center justify-between mb-4 gap-2">
            <span class="text-xs text-gray-400">
              {new Date(post.frontmatter.date).toLocaleDateString('nl-NL', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
              })}
            </span>
            <span class="text-xs text-cat-primary font-semibold">
              {post.frontmatter.author}
            </span>
          </div>
          {post.frontmatter.image && (
            <div class="flex justify-center mb-5">
              <img
                src={post.frontmatter.image}
                alt={post.frontmatter.title}
                class="w-full max-w-[640px] rounded-lg object-cover"
              />
            </div>
          )}

          <h2 class="text-2xl font-bold text-gray-900 mb-3">
            {post.frontmatter.title}
          </h2>

          <p class="text-gray-600 text-sm mb-5">
            {post.frontmatter.excerpt}
          </p>

          <div class="prose prose-sm sm:prose-base max-w-none text-gray-700">
            <post.Content />
          </div>
        </article>
      ))}
    </div>

    {sortedPosts.length === 0 && (
      <div class="text-center text-gray-400 py-16">
        <p class="text-lg">Nog geen blogposts beschikbaar. Kom binnenkort terug!</p>
      </div>
    )}
  </div>
</Layout>
