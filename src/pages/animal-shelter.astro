---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Adopteren - Animal shelter">
    <div class="container mx-auto px-4 py-8 sm:py-12">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-center text-cat-secondary mb-6 sm:mb-8">
            Adopteer een Kat
        </h1>

        <div class="max-w-8xl mx-auto bg-white border border-cat-primary p-6 rounded-lg  sm:p-6 md:p-8">
            <p class="text-sm sm:text-base text-gray-700 mb-4">
            Operatie Zwerfkat vzw werkt samen met Animal Shelter om katten een liefdevolle thuis te bieden.
            </p>
            <p class="text-sm sm:text-base text-gray-700 mb-4">
                Hieronder vindt u de beschikbare katten die klaar zijn voor adoptie:


            </p>

            <iframe src="https://www.adopteereendier.be/dierenasielen/operatie-zwerfkat-vzw/iframe" width="100%"
                    height="720"></iframe>

        </div>
    </div>
</Layout>
