---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Adopteren - Animal shelter">
    <div class="max-w-4xl mx-auto px-4 py-10 sm:py-16">
        <h1 class="text-3xl sm:text-4xl font-bold text-cat-primary mb-2">Adopteer een Kat</h1>
        <p class="text-gray-400 text-sm mb-8">Beschikbare katten via onze samenwerking met adopteereendier.be.</p>

        <div class="bg-white border border-gray-200 rounded-lg shadow-sm p-6 sm:p-8">
            <p class="text-gray-700 mb-2">
                Operatie Zwerfkat vzw werkt samen met Animal Shelter om katten een liefdevolle thuis te bieden.
            </p>
            <p class="text-gray-700 mb-6">
                Hieronder vindt u de beschikbare katten die klaar zijn voor adoptie:
            </p>
            <iframe src="https://www.adopteereendier.be/dierenasielen/operatie-zwerfkat-vzw/iframe" width="100%"
                    height="720" class="rounded"></iframe>
        </div>
    </div>
</Layout>
