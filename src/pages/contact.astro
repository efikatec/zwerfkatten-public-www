---
// src/pages/contact.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact - Operatie Zwerfkat vzw">
    <div class="max-w-3xl mx-auto px-4 py-10 sm:py-16">
        <p class="text-gray-400 text-sm mb-8">Voor vragen, samenwerkingen of hulp kunt u ons bereiken via onderstaande kanalen.</p>

        <div class="bg-white border border-gray-200 rounded-lg shadow-sm p-6 sm:p-8">
            <div class="space-y-3">
                <div class="flex items-start gap-4 p-4 bg-gray-50 rounded-lg">
                    <span class="text-sm font-medium text-gray-500 w-28 shrink-0 pt-0.5">E-mail</span>
                    <a href="mailto:bestuur@operatiezwerfkat.be" class="text-sm text-cat-primary hover:underline">bestuur@operatiezwerfkat.be</a>
                </div>

                <div class="flex items-start gap-4 p-4 bg-gray-50 rounded-lg">
                    <span class="text-sm font-medium text-gray-500 w-28 shrink-0 pt-0.5">SMS (Monika)</span>
                    <a href="sms:+32477270753" class="text-sm text-cat-primary hover:underline">+32 477 270 753</a>
                </div>

                <div class="flex items-start gap-4 p-4 bg-gray-50 rounded-lg">
                    <span class="text-sm font-medium text-gray-500 w-28 shrink-0 pt-0.5">WhatsApp</span>
                    <a href="https://wa.me/32477270753" target="_blank" rel="noopener noreferrer" class="text-sm text-cat-primary hover:underline">Start chat met Monika</a>
                </div>

                <div class="flex items-start gap-4 p-4 bg-gray-50 rounded-lg">
                    <span class="text-sm font-medium text-gray-500 w-28 shrink-0 pt-0.5">Facebook</span>
                    <a href="https://www.facebook.com/OperatieZwerfkat" target="_blank" rel="noopener noreferrer" class="text-sm text-cat-primary hover:underline">Operatie Zwerfkat op Facebook</a>
                </div>
            </div>
        </div>
    </div>
</Layout>
