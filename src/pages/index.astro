---
import Layout from '../layouts/Layout.astro';
import PhotoSlider from "../components/PhotoSlider.astro";
import { Image } from 'astro:assets';
import zwerfkatImg from '../assets/zwerfkat.webp';
import opvanggezinImg from '../assets/opvanggezin.webp';
import doneerImg from '../assets/doneer.webp';

const postModules = Object.values(import.meta.glob('../content/blog/*.md', {eager: true})) as any[];
const latestPosts = postModules
    .filter(p => p?.frontmatter?.date)
    .sort((a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime());
---

<Layout title="Home - Zwerfkat">

    <div class="max-w-6xl mx-auto px-4 py-8">
        <div class="flex flex-col lg:flex-row gap-8">
            <main class="w-full lg:w-3/4">

                <!-- How You Can Help -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-10">

                    <div class="bg-white border border-gray-200 rounded-lg overflow-hidden shadow-sm">
                        <div class="relative h-56">
                            <Image src={zwerfkatImg} alt="" aria-hidden="true"
                                   class="absolute inset-0 w-full h-full object-cover"
                                   loading="eager" />
                            <div class="absolute inset-0 bg-black/30"></div>
                            <div class="absolute inset-0 flex items-end justify-center pb-5">
                                <a href="/zwerfkatten"
                                   class="z-10 bg-white text-cat-primary px-5 py-2 rounded-md font-semibold text-sm shadow hover:bg-cat-primary hover:text-white focus:outline-none transition"
                                   aria-label="Meer info over zwerfkatten">
                                    Zwerfkatten vangen
                                </a>
                            </div>
                        </div>
                        <div class="px-6 py-4 text-center">
                            <p class="text-gray-600 text-sm">
                                Help ons zwerfkatten te vangen zodat we ze kunnen verzorgen en laten steriliseren.
                            </p>
                        </div>
                    </div>

                    <div class="bg-white border border-gray-200 rounded-lg overflow-hidden shadow-sm">
                        <div class="relative h-56">
                            <Image src={opvanggezinImg} alt="" aria-hidden="true"
                                   class="absolute inset-0 w-full h-full object-cover"
                                   loading="eager" />
                            <div class="absolute inset-0 bg-black/30"></div>
                            <div class="absolute inset-0 flex items-end justify-center pb-5">
                                <a href="/opvang-gezinnen"
                                   class="z-10 bg-white text-cat-primary px-5 py-2 rounded-md font-semibold text-sm shadow hover:bg-cat-primary hover:text-white focus:outline-none transition"
                                   aria-label="Meer info over opvanggezinnen">
                                    Word opvanggezin
                                </a>
                            </div>
                        </div>
                        <div class="px-6 py-4 text-center">
                            <p class="text-gray-600 text-sm">
                                Als opvanggezin maak je kittens en socialiseerbare zwerfkatten klaar voor adoptie.
                            </p>
                        </div>
                    </div>

                    <div class="bg-white border border-gray-200 rounded-lg overflow-hidden shadow-sm">
                        <div class="relative h-56">
                            <Image src={doneerImg} alt="" aria-hidden="true"
                                   class="absolute inset-0 w-full h-full object-cover"
                                   loading="eager" />
                            <div class="absolute inset-0 bg-black/30"></div>
                            <div class="absolute inset-0 flex items-end justify-center pb-5">
                                <a href="/doneren"
                                   class="z-10 bg-white text-cat-primary px-5 py-2 rounded-md font-semibold text-sm shadow hover:bg-cat-primary hover:text-white focus:outline-none transition"
                                   aria-label="Meer info over doneren">
                                    Doneer
                                </a>
                            </div>
                        </div>
                        <div class="px-6 py-4 text-center">
                            <p class="text-gray-600 text-sm">
                                Kan je niet fysiek helpen? Dan kan je ook doneren.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Photo slider -->
                <div class="mb-2">
                    <PhotoSlider/>
                </div>

            </main>

            <aside class="w-full lg:w-1/4 space-y-5">

                {latestPosts && latestPosts.length ? (
                    <section class="bg-white border border-gray-200 rounded-lg shadow-sm p-5">
                        <h4 class="text-xs font-semibold uppercase tracking-widest text-gray-400 mb-4">Purrrfect nieuws</h4>
                        <div class="space-y-5">
                            {latestPosts.slice(0, 2).map((post) => (
                                <article class="space-y-1">
                                    <a
                                        href={post.url ?? `/blog/${post.frontmatter?.slug ?? ''}`}
                                        class="block text-cat-primary font-semibold text-sm hover:underline leading-snug"
                                    >
                                        {post.frontmatter?.title}
                                    </a>
                                    <div class="text-xs text-gray-400">
                                        {new Date(post.frontmatter.date).toLocaleDateString('nl-NL', {year:'numeric',month:'long',day:'numeric'})}
                                    </div>
                                    <p class="text-gray-600 text-xs leading-relaxed">
                                        {post.frontmatter?.description ?? post.excerpt ?? ''}
                                    </p>
                                    <a
                                        href={post.url ?? `/blog/${post.frontmatter?.slug ?? ''}`}
                                        class="inline-block text-xs text-cat-primary font-medium hover:underline"
                                    >
                                        Lees meer →
                                    </a>
                                </article>
                            ))}
                        </div>
                    </section>
                ) : null}

                <section class="bg-white border border-gray-200 rounded-lg shadow-sm p-5">
                    <h3 class="text-xs font-semibold uppercase tracking-widest text-gray-400 mb-3">Onze Missie</h3>
                    <div class="relative">
                        <div class="max-h-52 overflow-hidden">
                            <p class="text-gray-600 text-sm leading-relaxed mb-2">
                                VZW Operatie Zwerfkat is reeds meer dan 20 jaar actief binnen Oudenaarde (en in
                                omstreken). De VZW bestaat uit een handvol vrijwilligers die zich ten volle inzetten
                                om zwerfkatten te vangen, op te vangen en hen een beter leven te geven.
                            </p>
                            <p class="text-gray-600 text-sm leading-relaxed">
                                De maatschappelijke impact van een vzw zoals VZW Operatie Zwerfkat wordt dikwijls
                                onderschat. Het leven van een zwerfkat kan allesbehalve geromantiseerd worden. De
                                leefomstandigheden op straat zijn niet rooskleurig.
                            </p>
                        </div>
                        <div class="pointer-events-none absolute left-0 right-0 bottom-0 h-12 bg-gradient-to-t from-white to-transparent"></div>
                    </div>
                    <a href="/onze-missie" class="inline-block mt-2 text-xs text-cat-primary font-medium hover:underline">Lees meer →</a>
                    <div class="mt-4 flex flex-col gap-2">
                        <a href="/animal-shelter"
                           class="text-center text-sm bg-cat-primary text-white px-4 py-2 rounded-md font-medium hover:brightness-95 transition">
                            Beschikbare katten
                        </a>
                        <a href="/contact"
                           class="text-center text-sm border border-cat-primary text-cat-primary px-4 py-2 rounded-md font-medium hover:bg-cat-primary hover:text-white transition">
                            Contacteer ons
                        </a>
                    </div>
                </section>

                <section class="bg-white border border-gray-200 rounded-lg shadow-sm p-5">
                    <h3 class="text-xs font-semibold uppercase tracking-widest text-gray-400 mb-3">Wettelijke verplichtingen</h3>
                    <div class="relative">
                        <div class="max-h-40 overflow-hidden">
                            <p class="text-gray-600 text-sm leading-relaxed">
                                Sinds 1 september 2014 moet elke kat die van eigenaar verandert gesteriliseerd zijn, ook
                                als het dier gratis wordt weggegeven. Sinds 1 april 2018 moet dat gebeuren voor de kat 5
                                maanden oud is. Op <a target="_blank" href="http://www.huisdierinfo.be/zoogdieren/katten" class="text-cat-primary hover:underline">de website van
                                huisdierinfo</a> vindt u nog meer informatie.
                            </p>
                        </div>
                        <div class="pointer-events-none absolute left-0 right-0 bottom-0 h-10 bg-gradient-to-t from-white to-transparent"></div>
                    </div>
                    <a href="/verplichtingen" class="inline-block mt-2 text-xs text-cat-primary font-medium hover:underline">Lees meer →</a>
                </section>

            </aside>
        </div>
    </div>

</Layout>
