---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const imageModules = import.meta.glob<{ default: ImageMetadata }>('../assets/slider/*.{jpg,jpeg,png,webp}', { eager: true });
const photos = Object.values(imageModules)
    .map(m => m.default)
    .filter(Boolean)
    .sort((a, b) => a.src.localeCompare(b.src));
---
<div id="photo-slider" class="max-w-8xl mx-auto relative">
    <div id="slides" class="relative overflow-hidden rounded-lg h-96 sm:h-[30rem] lg:h-[40rem] bg-gray-100">
        {photos.length === 0 ? (
                <div class="flex items-center justify-center h-full text-gray-500">No photos yet</div>
        ) : (
            photos.map((img, i) => (
                    <Image
                        src={img}
                        alt=""
                        data-index={i}
                        widths={[800, 1200, 1600]}
                        sizes="(max-width: 768px) 100vw, 75vw"
                        class={`absolute inset-0 w-full h-full object-cover transition-opacity duration-500 ${i === 0 ? 'opacity-100' : 'opacity-0'}`}
                        loading={i === 0 ? 'eager' : 'lazy'}
                    />
            ))
        )}
    </div>

    <button id="prev" class="absolute left-2 top-1/2 -translate-y-1/2 bg-white/80 p-2 rounded-full">‹</button>
    <button id="next" class="absolute right-2 top-1/2 -translate-y-1/2 bg-white/80 p-2 rounded-full">›</button>
</div>

<script type="module" is:inline>
    const slidesEl = document.getElementById('slides');
    const prevBtn = document.getElementById('prev');
    const nextBtn = document.getElementById('next');

    function initSlider() {
        const imgs = Array.from(slidesEl.querySelectorAll('img'));
        if (!imgs.length) return;
        let idx = 0;
        let timer = setInterval(next, 5000);

        function show(i) {
            imgs.forEach((img, j) => img.style.opacity = j === i ? '1' : '0');
            idx = i;
        }
        function next() { show((idx + 1) % imgs.length); }
        function prev() { show((idx - 1 + imgs.length) % imgs.length); }

        nextBtn.onclick = () => { next(); reset(); };
        prevBtn.onclick = () => { prev(); reset(); };

        function reset() { clearInterval(timer); timer = setInterval(next, 3000); }
    }

    window.addEventListener('load', () => { setTimeout(initSlider, 50); });
</script>
