---
import { Image as AstroImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
    src: ImageMetadata;
    alt: string;
    width?: number;
    height?: number;
    class?: string;
    loading?: 'lazy' | 'eager';
    quality?: number | 'low' | 'mid' | 'high' | 'max';
    format?: 'avif' | 'png' | 'webp' | 'jpeg' | 'jpg' | 'svg' | 'gif';
    [key: string]: unknown;
}

const { src, alt, class: className, ...rest } = Astro.props;
---

<AstroImage src={src} alt={alt} class={className} {...rest} />
